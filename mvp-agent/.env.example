# MVP AI部署助手 - 环境变量模板
# 使用前复制为 .env 并填写实际值
# =========================================

# AES 加密密钥（用于加密主机密码、SSH私钥、API Key等敏感信息）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_SECRET_KEY=replace_with_your_fernet_key_here

# JWT 签名密钥（用于签发和验证登录 Token）
JWT_SECRET=replace_with_your_jwt_secret_here

# DeepSeek API Key（AI部署助手默认 API，可在系统配置页面修改）
DEEPSEEK_API_KEY=

# SQLite 数据库文件路径
DB_PATH=data/db/mvp.db

# 服务监听端口
APP_PORT=8080

# 是否开发模式（开发模式开启热重载和详细日志）
DEBUG=true
